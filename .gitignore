# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Generated at runtime
data/earnings.db
outputs/
logs/
cache/
/tmp/

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem

# IDE
.cursor/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Archives (local review bundles)
*.zip

# Frontend (build output in static/ is committed for one-site Render deploy)
frontend/node_modules/
frontend/dist/

# Auto-grounding candidates are COMMITTED so Render (read-only FS) can read
# them offline — they're flagged auto_unverified in the deck/provenance, and a
# reviewer promotes a file into data/disclosed/ to upgrade it to hand-verified.
