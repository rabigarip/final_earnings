# ── Gemini (analyst prose) ─────────────────────────────────────────
# REQUIRED for the LLM commentary (exec summary, highlight pills,
# catalysts, risks, what-to-watch). Without it the deck still builds
# with deterministic sector-templated prose, but the writing is plainer.
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── On-demand freshness ────────────────────────────────────────────
# 1 (default) = refresh the requested ticker from Yahoo (+ best-effort
# Investing/MarketScreener) on every render, so the deck is never stale.
# 0 = render from whatever the canonical store holds (offline fixture tests).
# REFRESH_ON_RENDER=1

# ── Cloudflare bypass ──────────────────────────────────────────────
# 1 = fetch MarketScreener live via curl_cffi Chrome-TLS impersonation.
# MS_USE_CURL_CFFI=1

# ── Web API (Render / frontend) ────────────────────────────────────
# Restrict CORS to your frontend origin(s), comma-separated. Unset = allow *.
# CORS_ORIGINS=https://final-earnings-api.onrender.com

# ── Optional: NewsAPI for SCMP / China headlines (best-effort context) ─
# NEWSAPI_KEY=your-newsapi-key-here
